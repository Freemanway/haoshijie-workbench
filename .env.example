# 复制为 apps/server/.env 后填写
DATABASE_URL=postgresql://hsj:hsj@localhost:5432/hsj?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
# 手机号、地址字段加密密钥（32 字节 base64），生产环境放云 KMS
FIELD_ENCRYPTION_KEY=
# 登录令牌签名密钥，生产环境用长随机串
JWT_SECRET=change-me
# 开发环境直接以成员身份登录，生产环境必须为 false
AUTH_DEV_LOGIN=true
# 企业微信自建应用（扫码登录、消息推送）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 前端与接口地址，用于扫码登录回跳
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
# 首位管理员的企业微信成员账号（db:seed 时创建）
SEED_ADMIN_WECOM_ID=
SEED_ADMIN_NAME=
