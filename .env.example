# 复制为 apps/server/.env 后填写
DATABASE_URL=postgresql://hsj:hsj@localhost:5432/hsj?schema=public
REDIS_URL=redis://localhost:6379
PORT=3000
# 手机号、地址字段加密密钥（32 字节 base64），生产环境放云 KMS
FIELD_ENCRYPTION_KEY=
# 登录令牌签名密钥，生产环境用长随机串
JWT_SECRET=change-me
# 开发环境直接以成员身份登录，生产环境必须为 false
AUTH_DEV_LOGIN=true
# 企业微信自建应用（扫码登录、消息推送）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 前端与接口地址，用于扫码登录回跳
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
# 首位管理员的企业微信成员账号（db:seed 时创建）
SEED_ADMIN_WECOM_ID=
SEED_ADMIN_NAME=
# 大模型（OpenAI 兼容接口）。当前选用 DeepSeek，只需填 LLM_API_KEY；不填密钥则使用演示模型，只适合本地开发
# 换其他模型只改下面几项，例：通义千问  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 填好后运行 pnpm --filter @hsj/server llm:check 检查是否接通
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 模型不支持 response_format=json_object 时设为 false
LLM_JSON_MODE=true
# 单价（元 / 百万 tokens），按模型厂商当前价格填写，用于调用费用统计
LLM_PRICE_INPUT=0
LLM_PRICE_OUTPUT=0
# 每周四自动生成下周选题清单，设为 false 关闭定时任务
CRON_ENABLED=true
