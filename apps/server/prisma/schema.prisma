// 好时节AI工作台 数据模型初版（任务 M0-2）
// 对应 PRD 第 4–10 节。手机号、地址等个人信息以密文存储（*Enc），另存哈希（*Hash）用于去重匹配。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 账号与权限（PRD 10.1） ----------

enum Role {
  ADMIN // 管理员
  CONTENT // 内容运营
  REVIEWER // 审核人
  CS // 客服
  BIZ // 招商（B端销售）
  VIEWER // 管理层（只读）
}

enum Platform {
  XHS // 小红书（一期）
  DOUYIN // 抖音（二期）
  WECHAT_CHANNELS // 视频号（二期）
}

enum Audience {
  C
  B
}

model User {
  id        String   @id @default(cuid())
  wecomId   String   @unique // 企业微信成员 ID，用于扫码登录与消息推送
  name      String
  roles     Role[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  reviews       ReviewLog[]
  leads         Lead[]         @relation("LeadOwner")
  conversations Conversation[] @relation("ConversationAgent")
  followUps     FollowUp[]
}

model PlatformAccount {
  id           String   @id @default(cuid())
  platform     Platform
  name         String
  audience     Audience // 账号主要面向的客群
  externalId   String?
  dailyPostCap Int      @default(2) // 发布频率上限（PRD 10.2 平台合规）
  inboxMode    String   @default("manual") // 私信接入：manual 半自动（客服贴入、复制发送）| api 经授权服务商实时收发
  createdAt    DateTime @default(now())

  schedules     ScheduleItem[]
  conversations Conversation[]
  wecomChannels WecomChannel[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // 如 lead.export、lead.reveal_phone
  target    String?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

// ---------- 知识库与素材（PRD 4.1） ----------

model KnowledgeItem {
  id        String   @id @default(cuid())
  kind      String // variety 品种 | origin 产地 | season 上市时间 | price 价格规格 | compliance 合规表述范例
  title     String
  content   String
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model FaqItem {
  id        String    @id @default(cuid())
  category  String // 价格规格、品种区别、上市时间、配送范围、保存方法、售后、企业采购、代理政策
  question  String
  answer    String
  audience  Audience?
  updatedAt DateTime  @updatedAt
}

model Asset {
  id        String   @id @default(cuid())
  title     String
  url       String
  kind      String // image | video
  tags      String[]
  createdAt DateTime @default(now())
}

// ---------- 内容生产（PRD 4.1–4.5） ----------

enum TopicStatus {
  PROPOSED // AI 建议，待运营确认（每周选题清单）
  IDLE // 待用
  SCHEDULED // 已排期
  PUBLISHED // 已发布
  ARCHIVED // 归档
}

enum TopicSource {
  AI
  MANUAL
  INBOX_FAQ // 私信高频问题反哺
}

model Topic {
  id            String      @id @default(cuid())
  title         String
  audience      Audience
  category      String
  platforms     Platform[]
  seasonTag     String?
  status        TopicStatus @default(IDLE)
  source        TopicSource @default(MANUAL)
  reason        String? // AI 给出的选题理由
  suggestedDate DateTime?
  weekOf        DateTime? // 所属的每周选题清单（周一日期）
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  drafts Draft[]
  leads  Lead[]

  @@index([weekOf])
  @@index([status])
}

/**
 * 选题类别，预置 C 端 6 类、B 端 5 类，可增删（PRD 4.1）。
 */
model TopicCategory {
  id       String   @id @default(cuid())
  audience Audience
  name     String
  sort     Int      @default(0)

  @@unique([audience, name])
}

/**
 * 系统配置（每周选题配额、季节节点等），值为 JSON。
 */
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/**
 * 大模型调用日志：每次调用都留痕，可追溯到提示词模板版本、输入输出和费用（M4-1）。
 */
model LlmCall {
  id           String   @id @default(cuid())
  purpose      String // topics | draft | rewrite …
  template     String // 提示词模板名@版本
  provider     String
  model        String
  userId       String?
  refType      String? // topic | draft
  refId        String?
  messages     Json
  output       String?
  ok           Boolean
  error        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMilli    Int      @default(0) // 费用，单位：0.001 元
  latencyMs    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([refType, refId])
}

enum DraftStatus {
  GENERATING // AI 生成中
  GENERATE_FAILED // AI 生成失败，可重试
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  PUBLISH_FAILED
}

model Draft {
  id           String      @id @default(cuid())
  topicId      String
  platform     Platform
  status       DraftStatus @default(DRAFT)
  rejectReason String?
  error        String? // 生成失败原因
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  topic     Topic          @relation(fields: [topicId], references: [id])
  versions  DraftVersion[]
  reviews   ReviewLog[]
  schedules ScheduleItem[]
}

model DraftVersion {
  id          String   @id @default(cuid())
  draftId     String
  index       Int
  title       String
  body        String
  tags        String[]
  coverPrompt String?
  imageTips   String[] // 配图建议
  chosen      Boolean  @default(false)
  modelName   String? // 生成所用模型，AI 输出可追溯；人工修改为空
  note        String? // 这个版本怎么来的：首次生成、改语气、按驳回原因重写、人工修改…
  llmCallId   String?
  createdAt   DateTime @default(now())

  draft Draft @relation(fields: [draftId], references: [id])

  @@unique([draftId, index])
}

model ReviewLog {
  id         String   @id @default(cuid())
  draftId    String
  reviewerId String
  action     String // submit | withdraw | approve | reject | edit | comment
  note       String?
  versionId  String? // 操作针对的稿件版本
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  draft    Draft @relation(fields: [draftId], references: [id])
  reviewer User  @relation(fields: [reviewerId], references: [id])
}

model ScheduleItem {
  id           String    @id @default(cuid())
  draftId      String
  accountId    String
  publishAt    DateTime
  remindedAt   DateTime? // 到点提醒已发送
  publishedAt  DateTime?
  postUrl      String? // 人工回填的作品链接
  failedReason String? // 发布失败原因（如平台审核不通过）
  // 作品最新数据（一期人工回填，二期接口回收）；每次回填的快照在 PostMetric
  reads        Int?
  likes        Int?
  saves        Int?
  comments     Int?
  remind24At   DateTime? // 发布 24 小时数据回填提醒已发送
  remind7dAt   DateTime? // 发布 7 天数据回填提醒已发送
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  draft   Draft           @relation(fields: [draftId], references: [id])
  account PlatformAccount @relation(fields: [accountId], references: [id])
  metrics PostMetric[]

  @@index([publishAt])
}

/**
 * 作品数据快照：发布 24 小时、7 天各回填一次（M7-3）。
 */
model PostMetric {
  id             String   @id @default(cuid())
  scheduleItemId String
  checkpoint     String // 24h | 7d
  reads          Int
  likes          Int
  saves          Int
  comments       Int
  userId         String?
  recordedAt     DateTime @default(now())

  scheduleItem ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)

  @@unique([scheduleItemId, checkpoint])
}

// ---------- 私信接待（PRD 5） ----------

enum ConversationStatus {
  AI_HANDLING
  WAITING_AGENT
  AGENT_HANDLING
  DIVERTED // 已引流
  CLOSED
}

model Conversation {
  id             String             @id @default(cuid())
  accountId      String
  externalUserId String
  nickname       String?
  kind           String             @default("dm") // dm 私信 | comment 作品评论
  sourcePostUrl  String?
  status         ConversationStatus @default(AI_HANDLING)
  audience       Audience?
  intent         String? // high | medium | low
  handoffReason  String?
  summary        String?
  unmatched      Int                @default(0) // AI 连续没在知识库里找到答案的轮数
  agentId        String? // 接管的客服
  waitingSince   DateTime? // 转人工的时间，用于响应时限
  escalatedAt    DateTime? // 超时升级提醒已发送
  lastMessageAt  DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  account  PlatformAccount @relation(fields: [accountId], references: [id])
  agent    User?           @relation("ConversationAgent", fields: [agentId], references: [id])
  messages Message[]
  lead     Lead?

  @@unique([accountId, externalUserId])
  @@index([status, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  sender         String // customer | ai | agent | system
  text           String
  blockedText    String? // 被风控拦截的原回复
  externalId     String?  @unique // 平台消息 ID，防止重复处理
  delivery       String? // 发出的消息：to_send 待客服复制发送 | sending | sent | failed
  meta           Json? // AI 判断：客群、意向、命中的 FAQ、转人工原因
  authorId       String? // 客服回复的发送人
  llmCallId      String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

/**
 * 接收到的平台消息先原样落库再处理，处理失败定时重试，保证消息不丢（M8-1）。
 */
model InboundEvent {
  id          String    @id @default(cuid())
  channel     String // manual | api
  externalId  String    @unique
  payload     Json
  status      String    @default("pending") // pending | done | failed
  attempts    Int       @default(0)
  error       String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model RiskHitLog {
  id        String   @id @default(cuid())
  source    String // draft | reply
  sourceId  String
  word      String
  level     String
  category  String
  createdAt DateTime @default(now())

  @@index([word, createdAt])
}

model RiskWord {
  id         String    @id @default(cuid())
  word       String
  category   String
  level      String // block | warn | pass
  platform   Platform? // 空 = 所有平台通用
  whitelist  Boolean   @default(false) // 白名单词：即使命中其他规则也放行
  suggestion String? // 合规替换建议
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([word])
}

// ---------- 企业微信私域（PRD 5.5） ----------

/**
 * 渠道活码：每个平台账号一个“联系我”二维码或获客助手链接，加微时按 state 认来源。
 */
model WecomChannel {
  id          String   @id @default(cuid())
  kind        String // qr 联系我二维码 | link 获客助手链接
  name        String
  accountId   String?
  audience    Audience
  staff       String[] // 接待成员的企业微信账号，多人时轮流分配
  state       String   @unique // 渠道参数，加微回调里带回
  remoteId    String? // 联系我 config_id 或获客链接 link_id
  qrCode      String?
  url         String?
  tagId       String? // 来源标签
  welcomeText String? // 为空用默认欢迎语
  groupWayId  String? // 欢迎语附带的团购群活码
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account  PlatformAccount? @relation(fields: [accountId], references: [id])
  groupWay GroupJoinWay?    @relation(fields: [groupWayId], references: [id])
  contacts WecomContact[]
}

/**
 * 加了企业微信的客户（同一客户加多个成员各一条）。
 */
model WecomContact {
  id             String    @id @default(cuid())
  externalUserId String
  staffId        String // 被添加的成员企业微信账号
  name           String?
  state          String?
  channelId      String?
  leadId         String?
  welcome        String? // sent | failed | skipped
  tagged         Boolean   @default(false)
  addedAt        DateTime  @default(now())
  removedAt      DateTime?

  channel WecomChannel? @relation(fields: [channelId], references: [id])
  lead    Lead?         @relation(fields: [leadId], references: [id])

  @@unique([externalUserId, staffId])
  @@index([channelId, addedAt])
}

/**
 * 团购群活码（企业微信“加入群聊”）：最多 5 个群轮流，开启自动建群后群满自动建新群。
 */
model GroupJoinWay {
  id           String    @id @default(cuid())
  name         String
  chatIds      String[]
  autoCreate   Boolean   @default(true)
  roomBaseName String?
  roomBaseId   Int?
  state        String    @unique
  remoteId     String? // config_id
  qrCode       String?
  members      Json? // 最近一次检查的各群人数 { chatId: { name, count } }
  checkedAt    DateTime?
  fullAlertAt  DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  channels WecomChannel[]
}

// ---------- 线索与成交（PRD 6、9） ----------

enum LeadStatus {
  NEW
  ADDED_WECOM
  FOLLOWING
  WON
  LOST
}

model Lead {
  id               String     @id @default(cuid())
  audience         Audience
  conversationId   String?    @unique
  topicId          String?
  sourcePlatform   Platform?
  sourceAccount    String?
  sourcePostUrl    String?
  wecomChannel     String? // 来源渠道活码 WecomChannel.id
  nickname         String?
  name             String?
  phoneEnc         String?
  phoneHash        String?    @unique
  wechat           String?
  intent           String?
  intentDetail     Json?
  status           LeadStatus @default(NEW)
  ownerId          String?
  nextFollowAt     DateTime?
  lastFollowAt     DateTime?
  followRemindedAt DateTime? // 到期跟进提醒已发
  staleRemindedAt  DateTime? // 超 24 小时未跟进提醒已发
  editedFields     String[]   @default([]) // 人工改过的字段，AI 不再覆盖
  wonAt            DateTime? // 第一次成交
  dealCents        Int        @default(0) // 成交金额合计（不含退款取消）
  dealTool         String? // 最近一单的成交工具
  orderCount       Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt

  conversation  Conversation?  @relation(fields: [conversationId], references: [id])
  topic         Topic?         @relation(fields: [topicId], references: [id])
  owner         User?          @relation("LeadOwner", fields: [ownerId], references: [id])
  addresses     Address[]
  followUps     FollowUp[]
  orders        Order[]
  wecomContacts WecomContact[]
  sources       LeadSource[]

  @@index([audience, status, createdAt])
}

/**
 * 线索的每一次来源：私信会话、加企业微信、手动录入、导入。去重合并后都保留。
 */
model LeadSource {
  id             String    @id @default(cuid())
  leadId         String
  kind           String // conversation | wecom | manual | import
  platform       Platform?
  platformUserId String? // 平台用户 ID，同平台同 ID 视为同一客户
  accountName    String?
  postUrl        String?
  conversationId String?
  channelId      String?
  createdAt      DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([platform, platformUserId])
  @@index([leadId])
}

model Address {
  id          String   @id @default(cuid())
  leadId      String
  receiverEnc String
  phoneEnc    String
  province    String
  city        String
  district    String
  detailEnc   String
  confirmed   Boolean  @default(false)
  source      String   @default("manual") // chat 私信识别 | manual 手动 | import 批量导入
  phoneHash   String? // 收件电话的 HMAC，订单匹配用
  matchHash   String? // 收件人 + 地址的 HMAC，订单匹配用
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([phoneHash])
  @@index([matchHash])
}

model FollowUp {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  note      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Order {
  id           String    @id @default(cuid())
  tool         String // ktt 快团团 | jielong 群接龙 | huacheng 花城农夫 | other 其他 | manual 人工录入
  externalNo   String? // 工具里的订单号；没有订单号时用行内容生成，防重复导入
  importId     String?
  leadId       String?
  audience     Audience  @default(C)
  amountCents  Int
  quoteCents   Int? // B 端报价
  contractNo   String? // B 端合同编号
  product      String?
  quantity     Int?
  buyerNick    String? // 下单人昵称（不算个人信息，明文）
  receiverEnc  String?
  phoneEnc     String?
  addressEnc   String?
  province     String?
  phoneHash    String?
  receiverHash String? // 收货人 + 地址的 HMAC，用来匹配没留手机号的线索
  matchedBy    String? // phone | receiver_address | manual
  matchedAt    DateTime?
  /**
   * 归因：匹配时线索的来源平台、账号、作品和选题（快照，线索后来改了也不变）
   */
  attrPlatform Platform?
  attrAccount  String?
  attrPostUrl  String?
  attrTopicId  String?
  isRepeat     Boolean   @default(false) // 同一客户的第二单及以后
  cancelled    Boolean   @default(false) // 已退款或取消，不计成交金额
  rawStatus    String?
  note         String?
  createdById  String?
  orderedAt    DateTime
  importedAt   DateTime  @default(now())

  lead   Lead?        @relation(fields: [leadId], references: [id])
  import OrderImport? @relation(fields: [importId], references: [id])

  @@unique([tool, externalNo])
  @@index([phoneHash])
  @@index([receiverHash])
  @@index([leadId])
  @@index([orderedAt])
}

/// 一次订单表导入
model OrderImport {
  id          String   @id @default(cuid())
  tool        String
  fileName    String
  total       Int // 去掉表头后的订单数（同订单号多行算一单）
  created     Int
  duplicated  Int
  matched     Int
  failed      Int
  errors      Json? // [{ row, message }]
  createdById String
  createdAt   DateTime @default(now())

  orders Order[]
}

/// 周报、月报快照：生成时的指标（作品数据取当时的累计值）和 AI 解读
model Report {
  id        String    @id @default(cuid())
  kind      String // week | month
  from      String // 北京时间 YYYY-MM-DD，含
  to        String // 北京时间 YYYY-MM-DD，含
  data      Json
  insight   Json? // { highlights, problems, suggestions }
  llmCallId String?
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([kind, from])
}
